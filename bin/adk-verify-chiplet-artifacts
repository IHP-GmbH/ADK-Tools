#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""Verify the gds2kicad "prior steps" of the two_die_interposer example.

The example's KiCad library (footprints + symbols) is produced from chiplet
layouts with the gds2kicad tools. This gate reruns the reproducible steps on the
shipped inputs and checks them against the committed library, so an upstream
gds2kicad change that silently alters the demo artifacts fails the build:

  1. metal_test symbol   : regenerate from chiplets/metal_test_chiplet.pins.json
                           and require the full layout -- each pin's name, type
                           and position (which side it lands on) -- to equal the
                           committed .kicad_sym Metal_Test symbol; this gates that
                           the pin list carries the reviewed side/type.  [STRICT]
  2. io pad footprint     : regenerate interposer_bondpad via generate_io_pad and
                           diff the pad geometry against the committed one. [STRICT]
  3. pin-list fidelity    : re-extract the pin list from the committed footprint
                           and diff it against the shipped pins.json.    [STRICT]
  4. footprint from strip : run the GDS->footprint converter on the shipped,
                           curated Metal_Test_stripped.gds (only the 58 I/O pads
                           on 134/0, names on 134/25) and require the pad set --
                           name + shape + position + size + layers + custom-pad
                           copper outline -- to equal the committed footprint
                           exactly.                                      [STRICT]
  5. converter liveness   : run the converter on the full die GDS (474 raw shapes)
                           and require a valid, non-empty footprint.     [SMOKE]
  6. g2kproj session      : the shipped metal_test_chiplet.g2kproj (a GUI "Open
                           Project" session) has the right format + version, its
                           layer selections point at the die's pad/text layers,
                           and its embedded pin list matches the shipped
                           pins.json (no drift).                          [STRICT]

The 58-pad curation (which of the die's ~474 TopMetal2 shapes are real I/O pads)
is human-in-the-loop, but its result is shipped as chiplets/Metal_Test_stripped.gds,
so the footprint is reproducible one-shot from that input and gated by strict
equality in step 4 -- no manual step is needed to reproduce it. See
chiplets/README.md.
"""
import argparse
import json
import math
import os
import subprocess
import sys
import tempfile

PY = sys.executable  # the venv python (has the klayout module)


# ---------------------------------------------------------------------------
# minimal S-expression parser (enough for .kicad_mod / .kicad_sym)
# ---------------------------------------------------------------------------
def sexpr_parse(text):
    tokens, i, n = [], 0, len(text)
    def read(i):
        node = []
        while i < n:
            c = text[i]
            if c == '(':
                child, i = read(i + 1)
                node.append(child)
            elif c == ')':
                return node, i + 1
            elif c == '"':
                j = i + 1
                buf = []
                while j < n:
                    if text[j] == '\\':
                        buf.append(text[j + 1]); j += 2; continue
                    if text[j] == '"':
                        break
                    buf.append(text[j]); j += 1
                node.append(('str', ''.join(buf))); i = j + 1
            elif c.isspace():
                i += 1
            else:
                j = i
                while j < n and not text[j].isspace() and text[j] not in '()"':
                    j += 1
                node.append(('atom', text[i:j])); i = j
        return node, i
    # skip to first '('
    while i < n and text[i] != '(':
        i += 1
    root, _ = read(i + 1)
    return root


def head(node):
    """First element's atom/str value, or None."""
    if isinstance(node, list) and node:
        e = node[0]
        if isinstance(e, tuple):
            return e[1]
    return None


def val(node, idx):
    if isinstance(node, list) and len(node) > idx and isinstance(node[idx], tuple):
        return node[idx][1]
    return None


def walk(node):
    """Yield every list node in the tree (pre-order)."""
    if isinstance(node, list):
        yield node
        for e in node:
            if isinstance(e, list):
                yield from walk(e)


def find_symbol(root, name):
    for sub in walk(root):
        if head(sub) == 'symbol' and val(sub, 1) == name:
            return sub
    return None


def pin_names(node):
    """All pin names under a subtree (KiCad pin: (pin <type> <style> ... (name "X" ...)))."""
    names = []
    for sub in walk(node):
        if head(sub) == 'pin':
            for child in sub:
                if isinstance(child, list) and head(child) == 'name':
                    names.append(val(child, 1))
                    break
    return names


def pin_geometry(node):
    """Multiset-friendly list of (name, elec_type, x, y, angle) for every pin
    under a subtree. Captures the full symbol layout -- which side each pin sits
    on and its position -- not just the set of names, so a reproduced symbol can
    be compared for real equality. Pin form: (pin <elec_type> <style>
    (at x y ang) ... (name "X" ...))."""
    out = []
    for sub in walk(node):
        if head(sub) == 'pin':
            etype = val(sub, 1)
            name = None
            at = (None, None, None)
            for child in sub:
                if not isinstance(child, list):
                    continue
                if head(child) == 'name' and name is None:
                    name = val(child, 1)
                elif head(child) == 'at':
                    at = (round(float(val(child, 1)), 3),
                          round(float(val(child, 2)), 3),
                          int(float(val(child, 3))))
            out.append((name, etype, at[0], at[1], at[2]))
    return out


def pads(node):
    """List of pad dicts: number, shape, at(x,y), size(w,h), layers, poly.

    `poly` is the normalized (sorted, rounded) set of every (xy ...) vertex under
    the pad's `(primitives ...)` -- the real copper outline of an `smd custom`
    pad, which its bounding-box `(size ...)` does not capture.
    """
    out = []
    for sub in walk(node):
        if head(sub) != 'pad':
            continue
        pad = {'number': val(sub, 1), 'shape': val(sub, 3), 'at': None,
               'size': None, 'layers': [], 'poly': ()}
        for child in sub:
            if not isinstance(child, list):
                continue
            h = head(child)
            if h == 'at':
                pad['at'] = (round(float(val(child, 1)), 4), round(float(val(child, 2)), 4))
            elif h == 'size':
                pad['size'] = (round(float(val(child, 1)), 4), round(float(val(child, 2)), 4))
            elif h == 'layers':
                pad['layers'] = sorted(e[1] for e in child[1:] if isinstance(e, tuple))
            elif h == 'primitives':
                pts = [(round(float(val(p, 1)), 4), round(float(val(p, 2)), 4))
                       for p in walk(child) if head(p) == 'xy']
                pad['poly'] = tuple(sorted(pts))
        out.append(pad)
    return out


def prop(node, key):
    for sub in walk(node):
        if head(sub) == 'property' and val(sub, 1) == key:
            return val(sub, 2)
    return None


# ---------------------------------------------------------------------------
# checks
# ---------------------------------------------------------------------------
FAILS = []


def check(ok, label, detail=''):
    print(f"  [{'PASS' if ok else 'FAIL'}] {label}" + (f" - {detail}" if detail else ''))
    if not ok:
        FAILS.append(label)


def run_tool(args, **kw):
    return subprocess.run([PY] + args, capture_output=True, text=True, **kw)


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument('--example-dir', default='/opt/adk-tools/examples/two_die_interposer')
    ap.add_argument('--g2k-root', default=os.environ.get('GDS_TO_KICAD_ROOT', '/opt/adk-tools/gds_to_kicad'))
    a = ap.parse_args()

    ex, g2k = a.example_dir, a.g2k_root
    pretty = os.path.join(ex, 'kicad', 'two_die_interposer.pretty')
    fp_metal = os.path.join(pretty, 'metal_test_chiplet.kicad_mod')
    fp_iopad = os.path.join(pretty, 'interposer_bondpad.kicad_mod')
    committed_sym = os.path.join(ex, 'kicad', 'two_die_interposer.kicad_sym')
    pins_json = os.path.join(ex, 'chiplets', 'metal_test_chiplet.pins.json')
    die_gds = os.path.join(ex, 'chiplets', 'Metal_Test.gds')
    stripped_gds = os.path.join(ex, 'chiplets', 'Metal_Test_stripped.gds')
    g2kproj = os.path.join(ex, 'chiplets', 'metal_test_chiplet.g2kproj')
    lyp = os.path.join(g2k, 'pdks', 'sg13g2.lyp')

    for p in (fp_metal, fp_iopad, committed_sym, pins_json, die_gds, stripped_gds,
              g2kproj, lyp):
        if not os.path.exists(p):
            print(f"  [FAIL] missing input: {p}")
            FAILS.append('inputs')
    if FAILS:
        return fail()

    tmp = tempfile.mkdtemp(prefix='adk-g2k-verify.')
    shipped = json.load(open(pins_json))
    shipped_names = [p['name'] for p in shipped['pins']]

    print("gds2kicad prior-steps verification for two_die_interposer")
    print(f"  example : {ex}")
    print(f"  gds2kicad: {g2k}\n")

    # 1. symbol from pin list must reproduce the committed Metal_Test symbol
    #    exactly -- not just the same pin names, but the full layout (each pin's
    #    electrical type and its position, i.e. which side it lands on). This is
    #    the guarantee that the shipped pin list carries the reviewed side/type,
    #    so `gds_to_kicad_symbol.py --from-pin-list` (and the GUI's "generate
    #    symbol from pin list", same code path) rebuilds the committed symbol.
    regen_sym = os.path.join(tmp, 'Metal_Test.kicad_sym')
    r = run_tool([os.path.join(g2k, 'gds_to_kicad_symbol.py'),
                  '--from-pin-list', pins_json, '-o', regen_sym])
    if r.returncode != 0:
        check(False, 'symbol regenerates from pin list', r.stderr.strip()[-200:])
    else:
        regen_geo = pin_geometry(sexpr_parse(open(regen_sym).read()))
        committed_metal = find_symbol(sexpr_parse(open(committed_sym).read()), 'Metal_Test')
        committed_geo = pin_geometry(committed_metal) if committed_metal else []
        check(sorted(g[0] for g in regen_geo) == sorted(shipped_names),
              'regenerated symbol pin set == pin list',
              f"{len(regen_geo)} vs {len(shipped_names)}")
        check(len(regen_geo) == 58 and sorted(regen_geo) == sorted(committed_geo),
              'symbol from pin list == committed Metal_Test (name+type+position)',
              f"{len(regen_geo)} regen vs {len(committed_geo)} committed pins")

    # 2. io pad footprint geometry vs committed interposer_bondpad
    iodir = os.path.join(tmp, 'iopad')
    r = run_tool([os.path.join(g2k, 'io_pads', 'generate_io_pad.py'),
                  '--io-class', 'wire_bond', '--size', '100x100', '--out-dir', iodir])
    gen_mod = os.path.join(iodir, 'kicad_footprints', 'IOPad_WireBond_100x100.kicad_mod')
    if r.returncode != 0 or not os.path.exists(gen_mod):
        check(False, 'io pad regenerates', r.stderr.strip()[-200:])
    else:
        gp = pads(sexpr_parse(open(gen_mod).read()))
        cp = pads(sexpr_parse(open(fp_iopad).read()))
        same = (len(gp) == len(cp) == 1 and gp[0]['shape'] == cp[0]['shape']
                and gp[0]['size'] == cp[0]['size'] and gp[0]['at'] == cp[0]['at']
                and gp[0]['layers'] == cp[0]['layers'])
        check(same, 'io pad geometry == committed interposer_bondpad',
              f"gen {gp[:1]} vs committed {cp[:1]}")
        check(prop(sexpr_parse(open(fp_iopad).read()), 'IO_CLASS') == 'wire_bond',
              'committed io pad IO_CLASS == wire_bond')

    # 3. pin-list fidelity: re-extract from committed footprint, diff vs shipped
    re_json = os.path.join(tmp, 're_pins.json')
    r = run_tool([os.path.join(g2k, 'footprint_to_pinlist.py'), fp_metal,
                  '-o', re_json, '--name', 'metal_test_chiplet'])
    if r.returncode != 0:
        check(False, 'pin list re-extracts from footprint', r.stderr.strip()[-200:])
    else:
        rep = json.load(open(re_json))
        # side/type are the reviewed symbol-layout fields the shipped pin list
        # carries; a footprint has no such semantics (footprint_to_pinlist emits
        # left/passive), so the fidelity check compares only the footprint-derivable
        # fields: name + pad geometry. The side/type layer is gated in step 1.
        authored = {'side', 'type'}
        def normp(pins):
            norm = []
            for p in sorted(pins, key=lambda d: (d['name'], d.get('pad_index', 0))):
                norm.append({k: (round(v, 3) if isinstance(v, float) else v)
                             for k, v in p.items() if k not in authored})
            return norm
        check(normp(rep['pins']) == normp(shipped['pins']),
              'pin list fidelity (committed footprint == shipped pins.json, name+geometry)',
              f"{len(rep['pins'])} vs {len(shipped['pins'])} pins")

    # 4. reproduce the committed footprint straight from the shipped stripped GDS
    #    (pad shapes on 134/0, names on 134/25). Strict: the regenerated pad set
    #    -- name + shape + position + size + layers + custom-pad copper outline --
    #    must equal the committed footprint, so the one human-in-the-loop artifact
    #    is reproducible one-shot from a shipped input. The `poly` term matters:
    #    3 pads (DIV_OUTn/DIV_OUTp/sout) are `smd custom` octagons whose real
    #    copper is a gr_poly the bounding-box `size` does not capture, so a
    #    regression that flattened them to a same-bbox rect would slip a
    #    name+size-only check. UUIDs/float formatting are ignored.
    strip_mod = os.path.join(tmp, 'from_stripped.kicad_mod')
    r = run_tool([os.path.join(g2k, 'gds_to_kicad.py'), stripped_gds,
                  '--lyp-file', lyp, '--layer', 'TopMetal2.drawing',
                  '--text-layer-number', '134/25', '--flip-chip', '-o', strip_mod])
    if r.returncode != 0 or not os.path.exists(strip_mod):
        check(False, 'footprint regenerates from shipped stripped GDS',
              r.stderr.strip()[-200:])
    else:
        def padset(path):
            return sorted((p['number'], p['shape'], p['at'], p['size'],
                           tuple(p['layers']), p['poly'])
                          for p in pads(sexpr_parse(open(path).read())))
        gen, com = padset(strip_mod), padset(fp_metal)
        check(gen == com,
              'stripped-GDS footprint == committed metal_test footprint '
              '(name+shape+geometry+layers+custom-pad outline)',
              f"{len(gen)} vs {len(com)} pads"
              + ('' if gen == com else f"; first diff {next((a,b) for a,b in zip(gen,com) if a!=b)}"))

    # 5. converter liveness on the full die GDS (474 raw shapes, text auto-assoc).
    live_mod = os.path.join(tmp, 'live.kicad_mod')
    r = run_tool([os.path.join(g2k, 'gds_to_kicad.py'), die_gds,
                  '--lyp-file', lyp, '--layer', 'TopMetal2.drawing',
                  '--text-layer-number', '134/25', '--flip-chip', '-o', live_mod])
    ok = r.returncode == 0 and os.path.exists(live_mod)
    npads = 0
    if ok:
        txt = open(live_mod).read()
        npads = txt.count('(pad ')
        ok = npads > 0 and txt.count('(') == txt.count(')')
    check(ok, 'GDS->footprint converter liveness on Metal_Test.gds',
          f"{npads} pads" if ok else r.stderr.strip()[-200:])

    # 6. the shipped .g2kproj GUI session must stay consistent with the library:
    #    right format/version, its layer selections point at the die's pad (134/0)
    #    and text (134/25) layers, and its embedded pin list matches the committed
    #    pins.json -- so "File -> Open Project" reproduces the same footprint/symbol
    #    and the session cannot silently drift from the shipped pin list.
    proj = json.load(open(g2kproj))
    check(proj.get('format') == 'gds-to-kicad-project' and proj.get('version') == 1,
          '.g2kproj format/version', f"{proj.get('format')!r} v{proj.get('version')}")
    check('(134/0)' in proj.get('pad_layer', '') and '(134/25)' in proj.get('text_layer', ''),
          '.g2kproj pad/text layer selections',
          f"pad={proj.get('pad_layer')!r} text={proj.get('text_layer')!r}")
    # compare the full reviewed pin list -- name + side + type -- not just names,
    # so the embedded session reproduces the exact symbol layout (step 1), not
    # merely the same pin set.
    def keyset(pins):
        return sorted((p['name'], p.get('side'), p.get('type')) for p in pins)
    proj_pins = (proj.get('pin_list') or {}).get('pins', [])
    check(keyset(proj_pins) == keyset(shipped['pins']),
          '.g2kproj embedded pin list == shipped pins.json (name+side+type)',
          f"{len(proj_pins)} vs {len(shipped['pins'])} pins")

    return fail()


def fail():
    print()
    if FAILS:
        print(f"gds2kicad prior-steps verification FAILED: {', '.join(FAILS)}")
        return 1
    print("gds2kicad prior-steps verification: PASS")
    return 0


if __name__ == '__main__':
    sys.exit(main())
