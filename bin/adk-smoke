#!/bin/bash
# End-to-end smoke test: export the wire-bond demo headless through the full
# pipeline (pcbnew -> hyperlynx writer -> hyp_to_gds worker -> ADK assembly
# DRC) and fail unless the DRC passes. Verifies any running image in one
# command; also the last gate of the verify build stage.
set -euo pipefail

OUT="$(mktemp -d /tmp/adk-smoke.XXXXXX)"
trap 'rm -rf "$OUT"' EXIT

echo "adk-smoke: checking the interposer technology is registered in klayout"
cat > "$OUT/check_tech.py" <<'PY'
import os
import pya

names = list(pya.Technology.technology_names())
print("klayout technologies: %s" % ", ".join(sorted(names)))
assert "intm4tm2" in names, \
    "intm4tm2 technology not registered (KLAYOUT_PATH misses the interposer tree?)"
lyp = pya.Technology.technology_by_name("intm4tm2").eff_layer_properties_file()
assert lyp and os.path.isfile(lyp), "intm4tm2 layer properties not found: %r" % lyp
print("intm4tm2 layer properties: %s" % lyp)
PY
klayout -b -r "$OUT/check_tech.py"

echo "adk-smoke: exporting wire-bond demo to $OUT"
python3 /opt/adk-tools/chiplet_kicad_plugin/tests/regenerate_wirebond_demo.py \
    --require-drc \
    --board /opt/adk-tools/examples/interposer_wire_bonding_demo/kicad/interposer_wire_bonding_demo.kicad_pcb \
    --output-dir "$OUT"

echo
echo "adk-smoke: PASS (export + assembly DRC green)"
