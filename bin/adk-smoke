#!/bin/bash
# End-to-end smoke test: export the two-die interposer demo headless through the full
# pipeline (pcbnew -> hyperlynx writer -> hyp_to_gds worker -> ADK assembly
# DRC) and fail unless the DRC passes. Verifies any running image in one
# command; also the last gate of the verify build stage.
#
# Usage: adk-smoke BOARD.kicad_pcb
#
# The board has no default: the runtime image carries no demo, and a default
# under /opt/adk-tools/examples would name a path that exists only in the
# verify stage, which passes it explicitly. The demo's board is
# examples/two_die_interposer/kicad/two_die_interposer.kicad_pcb in the
# adk-tools clone, copied into /work.
set -euo pipefail

if [ "$#" -ne 1 ]; then
    echo "adk-smoke: name one board: copy examples/two_die_interposer from the adk-tools clone to /work/example, then run adk-smoke /work/example/kicad/two_die_interposer.kicad_pcb" >&2
    exit 2
fi
BOARD="$1"
if [ ! -f "$BOARD" ]; then
    echo "adk-smoke: no board at $BOARD" >&2
    exit 1
fi

OUT="$(mktemp -d /tmp/adk-smoke.XXXXXX)"
trap 'rm -rf "$OUT"' EXIT

echo "adk-smoke: checking the interposer technology is registered in klayout"
cat > "$OUT/check_tech.py" <<'PY'
import os
import pya

names = list(pya.Technology.technology_names())
print("klayout technologies: %s" % ", ".join(sorted(names)))
assert "intm4tm2" in names, \
    "intm4tm2 technology not registered (KLAYOUT_PATH misses the interposer tree?)"
lyp = pya.Technology.technology_by_name("intm4tm2").eff_layer_properties_file()
assert lyp and os.path.isfile(lyp), "intm4tm2 layer properties not found: %r" % lyp
print("intm4tm2 layer properties: %s" % lyp)
PY
klayout -b -r "$OUT/check_tech.py"

echo "adk-smoke: exporting two-die interposer demo to $OUT"
/opt/adk-tools/venv/bin/python3 /opt/adk-tools/chiplet_kicad_plugin/plugins/chiplet_export/tests/regenerate_wirebond_demo.py \
    --require-drc \
    --board "$BOARD" \
    --output-dir "$OUT"

echo
echo "adk-smoke: PASS (export + assembly DRC green)"
