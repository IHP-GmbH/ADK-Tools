#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""Fail the build when the shipped two_die_interposer demo deliverables no longer
match a fresh headless regeneration.

The runtime image bakes the *tracked* `examples/.../outputs/` deliverables (a
`COPY`, not a regeneration). The verify stage regenerates the demo into the same
tree, but that fresh product is discarded -- so a tracked set that has drifted
from what the current board + toolchain produce can still ship on a green build.
That is exactly how a stale .chiplet (old die geometry) and a missing pillar
manifest reached a release candidate once. This gate closes that hole.

Usage:
    adk-verify-demo-reproducible <tracked-snapshot-dir> <fresh-regen-dir>

It compares the two output trees over the *baked* deliverable set and exits
non-zero on any semantic difference:

  * SET equality -- every baked deliverable a fresh regen emits must be committed,
    and vice versa (catches a new sidecar like *.pillars.json silently absent).
  * `.chiplet`, `*.pillars.json`, `*.ixn_methods.json`, `MANIFEST.md`, and the
    `reports/` files (all deterministic) are compared byte-for-byte -- this is
    what catches die-geometry / thickness drift in the .chiplet.
  * `*.boundaries.json` is compared with `assembly_gds_sha256` dropped: that
    field only fingerprints the GDS, whose header carries a build timestamp, so
    it changes every run while the boundary geometry does not.
  * `*.gds` is compared by a geometry digest: the BGNLIB/BGNSTR timestamps are
    zeroed and the order of the cells, and of the elements inside each cell, is
    ignored, so a real geometry / layer / cell change is caught while
    klayout's per-run header timestamp and a writer that emits the same shapes
    in another sequence are not. Each element is still compared record for
    record. (The `.boundaries.json` polygons only fingerprint die placement,
    not the interposer routing, so the GDS itself must be gated too.)

Per-run and non-baked artifacts are ignored: `logs/`, `reports/assembly_drc/`,
`*.lyrdb` (klayout DRC results DB -- embeds an absolute run path and a run
timestamp; the DRC pass/fail is already enforced by --require-drc at regen
time), `*_complete.gds`, and `*.hyp` (kept in step with `.dockerignore`).
"""

import hashlib
import json
import sys
from pathlib import Path


def _is_ignored(rel):
    parts = rel.split("/")
    if "logs" in parts:
        return True
    if "assembly_drc" in parts:
        return True
    if rel.endswith(".lyrdb"):
        return True
    if rel.endswith("_complete.gds"):
        return True
    if rel.endswith(".hyp"):
        return True
    return False


# GDSII record types that carry modification/access timestamps (12 int16
# words each). klayout rewrites them with the current wall-clock time on every
# write, so they churn run-to-run while the geometry does not.
_GDS_BGNLIB = 0x01
_GDS_BGNSTR = 0x05
_GDS_ENDLIB = 0x04
_GDS_ENDSTR = 0x07
_GDS_ENDEL = 0x11
# ENDSTR carries no data, and the digest keeps only the fact of it; any other
# form refuses the stream rather than being hashed away.
_GDS_ENDSTR_REC = b"\x00\x04\x07\x00"
# Records that open an element: BOUNDARY, PATH, SREF, AREF, TEXT, NODE, BOX.
# Each element runs to its ENDEL.
_GDS_ELEMENTS = frozenset((0x08, 0x09, 0x0A, 0x0B, 0x0C, 0x15, 0x2D))


def _gds_records(data):
    """(record type, record bytes) pairs up to ENDLIB, or None if malformed.

    GDSII is a stream of records: a 2-byte big-endian length (header included),
    a 1-byte record type, a 1-byte data type, then the data. The BGNLIB and
    BGNSTR data, the only wall-clock timestamps, come back zeroed. Anything
    after ENDLIB is block padding and is dropped.
    """
    out = []
    i, n = 0, len(data)
    while i + 4 <= n:
        rec_len = (data[i] << 8) | data[i + 1]
        if rec_len < 4 or i + rec_len > n:
            return None  # malformed / truncated
        rectype = data[i + 2]
        rec = data[i:i + rec_len]
        if rectype in (_GDS_BGNLIB, _GDS_BGNSTR):
            rec = rec[:4] + b"\x00" * (rec_len - 4)
        out.append((rectype, rec))
        i += rec_len
        if rectype == _GDS_ENDLIB:
            return out
    return None  # no ENDLIB: truncated


def _gds_geometry_digest(path):
    """SHA-256 of a GDSII stream that ignores timestamps and emission order.

    The library is read as its header, its cells and ENDLIB. A cell is its
    BGNSTR/STRNAME records plus the multiset of its elements, each element
    kept as the exact bytes of its records (layer, datatype, coordinates,
    properties), so any change inside an element, an element added, removed
    or moved to another cell, a cell renamed, added or removed, or a header
    change (units, library name) flips the digest, while the same elements in
    another order, or the same cells in another order, do not. A polygon
    written from a different start vertex still counts as a change.

    Returns None on a malformed or truncated stream, or one whose elements
    and cells do not nest (an element outside a cell, a cell inside a cell,
    an element that never ends), or one with a record where this reading
    would lose its position (a cell record after the cell's first element,
    a library record between or after the cells other than ENDLIB), or an
    ENDSTR other than the empty record (the one record whose bytes the
    digest does not keep), so the caller can fall back to a raw byte compare
    rather than silently declaring a match.
    """
    records = _gds_records(Path(path).read_bytes())
    if records is None:
        return None

    header, cells = [], []
    cell = element = None
    for rectype, rec in records:
        if element is not None:
            element.append(rec)
            if rectype == _GDS_ENDEL:
                cell["elements"].append(b"".join(element))
                element = None
            elif rectype in _GDS_ELEMENTS or rectype in (
                    _GDS_BGNSTR, _GDS_ENDSTR, _GDS_ENDLIB):
                return None  # an element that never ends
        elif cell is not None:
            if rectype in _GDS_ELEMENTS:
                element = [rec]
            elif rectype == _GDS_ENDSTR:
                if rec != _GDS_ENDSTR_REC:
                    return None  # an ENDSTR with a datatype or data
                cells.append(cell)
                cell = None
            elif rectype in (_GDS_BGNSTR, _GDS_ENDEL, _GDS_ENDLIB):
                return None  # a cell inside a cell, or an unopened element
            elif cell["elements"]:
                return None  # a cell record after its first element
            else:
                cell["head"].append(rec)  # STRNAME and the like
        elif rectype == _GDS_BGNSTR:
            cell = {"head": [rec], "elements": []}
        elif rectype in _GDS_ELEMENTS or rectype in (_GDS_ENDSTR, _GDS_ENDEL):
            return None  # an element or a cell end outside any cell
        elif cells and rectype != _GDS_ENDLIB:
            return None  # a library record between or after the cells
        else:
            header.append(rec)  # HEADER, BGNLIB, LIBNAME, UNITS, ..., ENDLIB
    if cell is not None or element is not None:
        return None

    def frame(h, blob):
        h.update(len(blob).to_bytes(8, "big"))
        h.update(blob)

    canon = []
    for c in cells:
        ch = hashlib.sha256()
        frame(ch, b"".join(c["head"]))
        ch.update(len(c["elements"]).to_bytes(8, "big"))
        for e in sorted(c["elements"]):
            frame(ch, e)
        canon.append(ch.digest())
    h = hashlib.sha256()
    frame(h, b"".join(header))
    h.update(len(canon).to_bytes(8, "big"))
    for d in sorted(canon):
        h.update(d)
    return h.hexdigest()


def _rel_files(root):
    root = Path(root)
    out = set()
    for p in root.rglob("*"):
        if p.is_file():
            rel = str(p.relative_to(root))
            if not _is_ignored(rel):
                out.add(rel)
    return out


def _boundaries_geometry(text):
    """JSON with the volatile GDS fingerprint removed, canonically serialized."""
    def strip(obj):
        if isinstance(obj, dict):
            obj.pop("assembly_gds_sha256", None)
            for v in obj.values():
                strip(v)
        elif isinstance(obj, list):
            for v in obj:
                strip(v)
    data = json.loads(text)
    strip(data)
    return json.dumps(data, sort_keys=True)


def compare(tracked, fresh):
    tracked, fresh = Path(tracked), Path(fresh)
    diffs = []

    ft = _rel_files(tracked)
    ff = _rel_files(fresh)
    for rel in sorted(ft - ff):
        diffs.append("committed deliverable is not reproduced by a fresh "
                     "regen (stale/removed): %s" % rel)
    for rel in sorted(ff - ft):
        diffs.append("fresh regen emits a deliverable that is not committed "
                     "(missing from the shipped set): %s" % rel)

    for rel in sorted(ft & ff):
        tp, fp = tracked / rel, fresh / rel
        if rel.endswith(".boundaries.json"):
            if _boundaries_geometry(tp.read_text()) != _boundaries_geometry(fp.read_text()):
                diffs.append("boundary geometry differs: %s" % rel)
        elif rel.endswith(".gds"):
            dt, df = _gds_geometry_digest(tp), _gds_geometry_digest(fp)
            if dt is None or df is None:
                # unparseable stream -- fall back to a raw byte compare so a
                # real difference is never silently passed as reproducible
                if tp.read_bytes() != fp.read_bytes():
                    diffs.append("GDS content differs (unparseable stream, "
                                 "byte compare): %s" % rel)
            elif dt != df:
                diffs.append("GDS geometry differs from a fresh regen "
                             "(digest without timestamps or emission order): "
                             "%s" % rel)
        else:
            if tp.read_bytes() != fp.read_bytes():
                diffs.append("content differs from a fresh regen: %s" % rel)
    return diffs


def main(argv):
    if len(argv) != 3:
        print(__doc__)
        print("error: expected exactly two directory arguments", file=sys.stderr)
        return 2
    tracked, fresh = argv[1], argv[2]
    for d in (tracked, fresh):
        if not Path(d).is_dir():
            print("error: not a directory: %s" % d, file=sys.stderr)
            return 2

    diffs = compare(tracked, fresh)
    if diffs:
        print("FAIL: shipped demo outputs are not reproducible from the current "
              "board + toolchain. The tracked examples/two_die_interposer/outputs/"
              " tree must be regenerated and committed.", file=sys.stderr)
        for d in diffs:
            print("  - %s" % d, file=sys.stderr)
        return 1

    print("OK: shipped two_die_interposer demo outputs match a fresh headless "
          "regeneration (die geometry, pillar manifests, boundaries, reports).")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
