#!/bin/bash
# Seed the /work structure on first run, then exec the requested command.
#
#   /work/example              wire-bond demo, copied here if absent (disposable)
#   /work/heterogenic-designs  persistent host<->container exchange dir
#
# Skipped silently when /work is not writable (e.g. plain docker run without
# the run.sh mount).
if [ -d /work ] && [ -w /work ]; then
    mkdir -p /work/heterogenic-designs
    if [ ! -d /work/example ]; then
        cp -r /opt/adk-tools/examples/interposer_wire_bonding_demo /work/example 2>/dev/null || true
    fi
fi

# Pre-seed KiCad's global library tables (suppresses the first-run
# "configure library table" dialog; the templates point at the shipped
# /usr/share/kicad/{symbols,footprints}).
kicad_cfg="${HOME:-/tmp}/.config/kicad/9.99"
if [ ! -f "$kicad_cfg/sym-lib-table" ]; then
    mkdir -p "$kicad_cfg" 2>/dev/null \
        && cp -n /usr/share/kicad/template/sym-lib-table \
                 /usr/share/kicad/template/fp-lib-table \
                 "$kicad_cfg/" 2>/dev/null || true
fi
exec "$@"
