# Git metadata (submodule gitfiles included); the image gets versions via the
# manifest, not via git history.
.git
.gitmodules
**/.git

# Host build artifacts: everything compiles inside the image
tools/kicad/build
tools/chiplet-studio/build
tools/chiplet-studio/extern/klayout/build-release
tools/chiplet-studio/extern/klayout/bin-release
tools/chiplet-studio/extern/klayout/build-debug
tools/chiplet-studio/extern/klayout/bin-debug

# Python noise
**/__pycache__
**/*.pyc
**/.venv
**/.pytest_cache

# Generated at build time / local files
manifest.json
*.log

# Demo artifacts regenerated by the verify stage: never bake a developer's local
# scratch output into the image (mirrors .gitignore; verify regenerates them, and
# the tracked interposer GDS is not matched by these globs).
examples/**/*.hyp
examples/**/*_complete.gds
examples/**/*.lyrdb
examples/**/*.boundaries.json
examples/**/*.ixn_methods.json
examples/**/*_cupillar_drc.json
examples/**/assembly_drc
examples/**/*-backups
examples/**/fp-info-cache
examples/**/*.kicad_prl
examples/**/_autosave-*
examples/**/*.lck
